{
  "name": "@selemondev/vue3-marquee",
  "version": "1.4.0",
  "description": "A Beautiful Marquee component for Vue 3 ✨",
  "keywords": [
    "marquee",
    "nuxt",
    "tailwindcss",
    "typescript",
    "vue",
    "vue-marquee",
    "vue3"
  ],
  "homepage": "https://vue-marquee.selemon.dev",
  "bugs": {
    "url": "https://github.com/selemondev/marquee/issues"
  },
  "license": "MIT",
  "author": "Selemondev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/selemondev/marquee.git",
    "directory": "packages/vue3-marquee"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json",
    "./style.css": "./dist/style.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:package": "vp pack && pnpm build:css && publint",
    "build:css": "tailwindcss -i ./src/assets/css/tailwind.css -o ./dist/style.css --minify",
    "dev": "vp pack --watch",
    "test": "vp test run",
    "coverage": "vp test run --coverage",
    "prepublishOnly": "pnpm build:package",
    "package": "pnpm publish",
    "package:beta": "pnpm publish --tag beta"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.0",
    "clsx": "^2.1.1",
    "happy-dom": "^20.14.0",
    "publint": "^0.3.24",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~5.9.3",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vue": "^3.5.42",
    "vue-tsc": "^3.3.11"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.34.5",
  "inlinedDependencies": {
    "clsx": "2.1.1",
    "tailwind-merge": "3.6.0"
  }
}
